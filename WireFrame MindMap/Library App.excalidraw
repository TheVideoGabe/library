    {
      "id": "-4gjOQLxuMjlQeHNjM5m5",
      "type": "text",
      "x": -419.1498110398463,
      "y": 347.5997201996752,
      "width": 1077.9996337890625,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8",
      "roundness": null,
      "seed": 1852148963,
      "version": 866,
      "versionNonce": 1335645485,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779060954434,
      "link": null,
      "locked": false,
      "text": "Store objects {Book} in array.\nCreate a class for books with a default constructor\nCreate an add (& store), remove, and update functions outside of class\nEvery instance should have a unique ID (crypto UUID method)\nA function that loops through book array and displays them in cards\nNew book should trigger a modal to add books\nEdit book buttons should trigger a modal to update the book\nEach card should have a remove book button\nAdding a toggle for Read/Unread",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Store objects {Book} in array.\nCreate a class for books with a default constructor\nCreate an add (& store), remove, and update functions outside of class\nEvery instance should have a unique ID (crypto UUID method)\nA function that loops through book array and displays them in cards\nNew book should trigger a modal to add books\nEdit book buttons should trigger a modal to update the book\nEach card should have a remove book button\nAdding a toggle for Read/Unread",
      "autoResize": true,
      "lineHeight": 1.25
    },
